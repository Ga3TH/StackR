<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brand.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Espacements (4 / 8 / 12 / 16 / 24) ===== -->
    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceS">8</sys:Double>
    <sys:Double x:Key="SpaceM">12</sys:Double>
    <sys:Double x:Key="SpaceL">16</sys:Double>
    <sys:Double x:Key="SpaceXl">24</sys:Double>

    <Thickness x:Key="PaddingXs">4</Thickness>
    <Thickness x:Key="PaddingS">8</Thickness>
    <Thickness x:Key="PaddingM">12</Thickness>
    <Thickness x:Key="PaddingL">16</Thickness>
    <Thickness x:Key="PaddingXl">24</Thickness>
    <Thickness x:Key="PagePadding">32,24,32,24</Thickness>

    <!-- ===== Rayons ===== -->
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ===== Typographie ===== -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeSection">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- ===== Cartes ===== -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource PaddingL}" />
    </Style>

    <!-- Carte cliquable : survol plus lumineux, liseré violet -->
    <Style x:Key="InteractiveCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandVioletBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Pastille d'état (ex. Actif, Arrêté) -->
    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Tuile d'icône à dégradé de marque -->
    <Style x:Key="BrandTileBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
    </Style>

    <!-- Fine ligne d'accent dégradée -->
    <Style x:Key="AccentLineStyle" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{StaticResource BrandLineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Petit trait d'accent sous un titre de page -->
    <Style x:Key="TitleUnderlineStyle" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="Width" Value="48" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource BrandLineBrush}" />
    </Style>

    <!-- ===== Profondeur : ombre douce (visible en clair, quasi invisible en sombre où le liseré suffit) ===== -->
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.07" Color="Black" />

    <!-- Carte surélevée : ombre douce, soulevée au survol (Motion.HoverLift) -->
    <Style x:Key="ElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Pastille colorée selon Tag : Success, Caution, Critical, Attention, sinon neutre -->
    <Style x:Key="TonePillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Caution">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Attention">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Point d'état (même code couleur que les pastilles) -->
    <Style x:Key="ToneDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Caution">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Puce discrète (port, type de projet, Git…) -->
    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Petite étiquette de section (MAJUSCULES espacées) -->
    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Valeur chiffrée d'une carte (mémoire, durée…) -->
    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Texte d'accent lisible en clair comme en sombre -->
    <Style x:Key="AccentTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>

</ResourceDictionary>
