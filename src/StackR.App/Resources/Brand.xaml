<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Identité de marque : violet #7C3AED -> cyan #06B6D4 -->
    <Color x:Key="BrandVioletColor">#7C3AED</Color>
    <Color x:Key="BrandCyanColor">#06B6D4</Color>

    <SolidColorBrush x:Key="BrandVioletBrush" Color="{StaticResource BrandVioletColor}" />
    <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyanColor}" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource BrandVioletColor}" />
        <GradientStop Offset="1" Color="{StaticResource BrandCyanColor}" />
    </LinearGradientBrush>

    <!-- Ligne d'accent horizontale (gauche -> droite) -->
    <LinearGradientBrush x:Key="BrandLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource BrandVioletColor}" />
        <GradientStop Offset="1" Color="{StaticResource BrandCyanColor}" />
    </LinearGradientBrush>

    <!-- Logo vectoriel : losange arrondi dégradé + « R » -->
    <DrawingImage x:Key="StackRLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,64,64" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource BrandGradientBrush}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="13.5,13.5,37,37" RadiusX="8.5" RadiusY="8.5">
                                <RectangleGeometry.Transform>
                                    <RotateTransform Angle="45" CenterX="32" CenterY="32" />
                                </RectangleGeometry.Transform>
                            </RectangleGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="4.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 25.5,43 L 25.5,21.5 L 34,21.5 C 41.5,21.5 41.5,33 34,33 L 25.5,33 M 33.5,33 L 40,43" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
