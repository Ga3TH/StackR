<ui:FluentWindow x:Class="StackR.App.Views.NewSiteDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:StackR.App.Resources"
                 Title="{x:Static res:Strings.SitesNewTitle}"
                 Width="600" SizeToContent="Height" MaxHeight="760"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.SitesNewTitle}"
                     ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="28,12,28,24">
            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Static res:Strings.SitesNewTitle}" />
            <Border Style="{StaticResource TitleUnderlineStyle}" Margin="0,8,0,16" />

            <!-- Nom -->
            <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SitesNameLabel}" />
            <ui:TextBox x:Name="NameBox" Margin="0,6,0,0"
                        PlaceholderText="{x:Static res:Strings.SitesNamePlaceholder}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEditable}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Text="{Binding NameError}"
                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal"
                        Visibility="{Binding HasUrlPreview, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               VerticalAlignment="Center" />
                <TextBlock Margin="6,0,0,0" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding UrlPreview}" />
            </StackPanel>

            <!-- Modèle -->
            <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,20,0,0"
                       Text="{x:Static res:Strings.SitesTemplateLabel}" />
            <RadioButton GroupName="Template" Margin="0,6,0,0" IsChecked="True"
                         IsEnabled="{Binding IsEditable}"
                         Content="{x:Static res:Strings.SitesTemplateEmpty}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="28,-2,0,0" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.SitesTemplateEmptyHint}" />
            <RadioButton GroupName="Template" Margin="0,6,0,0"
                         IsChecked="{Binding IsLaravel, Mode=TwoWay}"
                         IsEnabled="{Binding IsLaravelEnabled}"
                         Content="{x:Static res:Strings.SitesTemplateLaravel}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="28,-2,0,0" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.SitesTemplateLaravelHint}" />
            <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                        IsOpen="{Binding HasLaravelWarning, Mode=OneWay}"
                        Message="{Binding LaravelUnavailable}" />

            <!-- Progression et sortie de Composer -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowOutput, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{x:Static res:Strings.SitesLaravelRunning}" />
                </StackPanel>
                <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="170" IsReadOnly="True"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Text="{Binding Log, Mode=OneWay}" />
            </StackPanel>

            <!-- Résultat -->
            <ui:InfoBar Margin="0,16,0,0" IsClosable="False"
                        IsOpen="{Binding HasResult, Mode=OneWay}"
                        Severity="{Binding ResultSeverity}"
                        Message="{Binding ResultMessage}" />

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                           Content="{x:Static res:Strings.SitesCreate}"
                           Command="{Binding CreateCommand}"
                           Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Open24}"
                           Content="{x:Static res:Strings.SitesOpen}"
                           Command="{Binding OpenCreatedCommand}"
                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Margin="8,0,0,0" Content="{x:Static res:Strings.SitesCancelRun}"
                           Command="{Binding CreateCancelCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button x:Name="CloseButton" Margin="8,0,0,0" Content="{x:Static res:Strings.SitesClose}"
                           Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
