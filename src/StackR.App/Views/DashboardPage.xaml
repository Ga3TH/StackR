<Page x:Class="StackR.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:StackR.App.Views"
      xmlns:svc="clr-namespace:StackR.App.Services"
      xmlns:res="clr-namespace:StackR.App.Resources"
      Title="{Binding Title}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Visible seulement si le composant n'est pas installé -->
        <Style x:Key="WhenNotInstalledStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenInstalledStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton principal tant que le service est arrêté, secondaire une fois actif -->
        <Style x:Key="ToggleButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Appearance" Value="Secondary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoSitesStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRecentSites}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tuile d'outil rapide : icône, nom, courte phrase -->
        <Style x:Key="ToolTileStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinHeight" Value="58" />
        </Style>

        <DataTemplate x:Key="ServiceCardTemplate">
            <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,14,14"
                    svc:Motion.Appear="True" svc:Motion.HoverLift="True">
                <StackPanel>
                    <!-- En-tête : tuile, nom, version, pastille d'état -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Style="{StaticResource BrandTileBorderStyle}" CornerRadius="10">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="21" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" FontSize="17" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding VersionText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource TonePillStyle}" Tag="{Binding Tone}"
                                svc:Motion.Pulse="{Binding IsTransitioning}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource ToneDotStyle}" Tag="{Binding Tone}" Width="7" Height="7" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Mesures en direct -->
                    <Grid Margin="0,18,0,0" Style="{StaticResource WhenInstalledStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Static res:Strings.UiMemory}" />
                            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding MemoryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Static res:Strings.UiUptime}" />
                            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding UptimeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" MinWidth="48">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Static res:Strings.UiPid}" />
                            <TextBlock Style="{StaticResource MetricValueTextStyle}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Text="{Binding PidText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Ports -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Style="{StaticResource WhenInstalledStyle}">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,8,6"
                                   Text="{x:Static res:Strings.UiPortsLabel}" />
                        <ItemsControl ItemsSource="{Binding Ports}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChipBorderStyle}">
                                        <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ui:InfoBar Margin="0,8,0,0" Severity="Error" IsClosable="False"
                                Title="{x:Static res:Strings.DashLastError}"
                                Message="{Binding ErrorMessage}"
                                IsOpen="{Binding HasError}" />

                    <StackPanel Style="{StaticResource WhenNotInstalledStyle}" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.DashNotInstalledHint}" />
                        <ui:Button Margin="0,10,0,0" Appearance="Secondary" HorizontalAlignment="Left"
                                   Content="{x:Static res:Strings.DashGoToVersions}" Command="{Binding OpenVersionsCommand}"
                                   ToolTip="{x:Static res:Strings.CapDashGoToVersions}" />
                    </StackPanel>

                    <!-- Actions -->
                    <Grid Margin="0,12,0,0" Style="{StaticResource WhenInstalledStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Style="{StaticResource ToggleButtonStyle}" Command="{Binding ToggleCommand}"
                                   ToolTip="{Binding Name, StringFormat={x:Static res:Strings.CapCardToggleFormat}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="{Binding ActionIcon}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ActionText}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Command="{Binding RestartCommand}" ToolTip="{x:Static res:Strings.UiRestart}"
                                   AutomationProperties.Name="{x:Static res:Strings.UiRestart}" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                   Command="{Binding OpenLogsCommand}" ToolTip="{x:Static res:Strings.UiLogs}"
                                   AutomationProperties.Name="{x:Static res:Strings.UiLogs}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête accueillant + résumé -->
            <Grid Grid.Row="0" svc:Motion.Appear="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Greeting}" />
                    <Border Style="{StaticResource TitleUnderlineStyle}" Margin="0,8,0,10" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" FontSize="15" Text="{Binding Summary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Content="{x:Static res:Strings.DashStartAll}"
                               Command="{Binding StartAllCommand}" ToolTip="{x:Static res:Strings.CapDashStartAll}" Padding="16,8" />
                    <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Stop24}" Content="{x:Static res:Strings.DashStopAll}"
                               Command="{Binding StopAllCommand}" ToolTip="{x:Static res:Strings.CapDashStopAll}" Padding="16,8" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <ui:InfoBar Margin="0,20,0,0"
                            IsOpen="{Binding IsNoticeOpen, Mode=TwoWay}"
                            Severity="{Binding NoticeSeverity}"
                            Message="{Binding NoticeMessage}"
                            IsClosable="True" />
                <ui:InfoBar Margin="0,16,0,0" Severity="Warning" IsClosable="True"
                            IsOpen="{Binding HasPortTip, Mode=TwoWay}"
                            Title="{Binding PortTipTitle}"
                            Message="{Binding PortTipBody}" />
            </StackPanel>

            <ItemsControl Grid.Row="2" Margin="0,24,-14,0" ItemsSource="{Binding Cards}"
                          ItemTemplate="{StaticResource ServiceCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Grid.Row="3" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Mes sites -->
                <Border Style="{StaticResource ElevatedCardStyle}" svc:Motion.Appear="True">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" FontSize="16" Text="{x:Static res:Strings.UiMySites}" />
                            <ui:HyperlinkButton HorizontalAlignment="Right" Padding="4,0" Content="{x:Static res:Strings.UiSeeAll}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                Command="{Binding GoToCommand}" CommandParameter="sites" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentSites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Globe24" FontSize="18" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Host}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource ChipBorderStyle}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Framework}" />
                                            </Border>
                                            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Open24}" Appearance="Transparent"
                                                       ToolTip="{x:Static res:Strings.CapSitesOpen}"
                                                       AutomationProperties.Name="{x:Static res:Strings.SitesOpen}"
                                                       Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding Host}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Style="{StaticResource NoSitesStyle}" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.UiTipFirstSiteTitle}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" Text="{x:Static res:Strings.UiTipFirstSiteBody}" />
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="{x:Static res:Strings.SitesNew}"
                                       Command="{Binding GoToCommand}" CommandParameter="sites" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outils rapides + PHP actif -->
                <Border Grid.Column="2" Style="{StaticResource ElevatedCardStyle}" svc:Motion.Appear="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" FontSize="16" Margin="0,0,0,12" Text="{x:Static res:Strings.UiQuickTools}" />
                        <UniformGrid Columns="2" Margin="0,0,-8,0">
                            <ui:Button Style="{StaticResource ToolTileStyle}" Command="{Binding OpenTerminalCommand}" ToolTip="{x:Static res:Strings.CapDashOpenTerminal}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="WindowConsole20" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.UiToolTerminal}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.UiToolTerminalHint}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Style="{StaticResource ToolTileStyle}" Command="{Binding OpenWwwCommand}" ToolTip="{x:Static res:Strings.CapDashOpenWww}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.UiToolWww}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.UiToolWwwHint}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Style="{StaticResource ToolTileStyle}" Command="{Binding Database.OpenHeidiCommand}" ToolTip="{Binding Database.HeidiHint}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Database24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.UiToolHeidi}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.UiToolHeidiHint}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Style="{StaticResource ToolTileStyle}" Command="{Binding Database.OpenAdminerCommand}" ToolTip="{Binding Database.AdminerHint}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DatabaseSearch24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.UiToolAdminer}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.UiToolAdminerHint}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Style="{StaticResource ToolTileStyle}" Command="{Binding OpenMailpitCommand}" ToolTip="{x:Static res:Strings.CapDashOpenMailpit}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Mail24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.UiToolMailpit}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.UiToolMailpitHint}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Button>
                        </UniformGrid>

                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.DashPhpActive}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.DashPhpHint}" TextWrapping="Wrap" MaxWidth="200" />
                            </StackPanel>
                            <ui:ProgressRing Grid.Column="1" Margin="10,0" Width="16" Height="16" IsIndeterminate="True" HorizontalAlignment="Right"
                                             Visibility="{Binding IsPhpBusy, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox Grid.Column="2" MinWidth="120" VerticalAlignment="Center"
                                      ItemsSource="{Binding PhpVersions}"
                                      SelectedItem="{Binding SelectedPhp, Mode=TwoWay}"
                                      IsEnabled="{Binding HasPhp}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
