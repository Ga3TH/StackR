<Page x:Class="StackR.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:StackR.App.Views"
      xmlns:res="clr-namespace:StackR.App.Resources"
      Title="{Binding Title}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Pastille d'état : gris = arrêté, vert = actif, orange clignotant = transition, rouge = erreur -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.55" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Visible seulement si le composant n'est pas installé -->
        <Style x:Key="WhenNotInstalledStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Anneau de progression visible pendant démarrage / arrêt -->
        <Style x:Key="TransitionRingStyle" TargetType="ui:ProgressRing">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton principal tant que le service est arrêté, secondaire une fois actif -->
        <Style x:Key="ToggleButtonStyle" TargetType="views:CaptionedButton">
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CaptionWidth" Value="320" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Appearance" Value="Secondary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoSitesTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRecentSites}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ServiceCardTemplate">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Style="{StaticResource BrandTileBorderStyle}">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding VersionText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Ellipse Style="{StaticResource StatusDotStyle}" />
                        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Text="{Binding StatusText}" />
                        <ui:ProgressRing Style="{StaticResource TransitionRingStyle}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" Text="{Binding PortsText}" />

                    <views:CaptionedButton Style="{StaticResource ToggleButtonStyle}" Margin="0,16,0,0"
                                           Command="{Binding ToggleCommand}"
                                           Caption="{Binding Name, StringFormat={x:Static res:Strings.CapCardToggleFormat}}">
                        <views:CaptionedButton.Label>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="{Binding ActionIcon}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ActionText}" />
                            </StackPanel>
                        </views:CaptionedButton.Label>
                    </views:CaptionedButton>

                    <ui:InfoBar Margin="0,12,0,0" Severity="Error" IsClosable="False"
                                Title="{x:Static res:Strings.DashLastError}"
                                Message="{Binding ErrorMessage}"
                                IsOpen="{Binding HasError}" />

                    <StackPanel Style="{StaticResource WhenNotInstalledStyle}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.DashNotInstalledHint}" />
                        <views:CaptionedButton Margin="0,8,0,0" Appearance="Secondary" HorizontalAlignment="Left" Label="{x:Static res:Strings.DashGoToVersions}" Command="{Binding OpenVersionsCommand}" Caption="{x:Static res:Strings.CapDashGoToVersions}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Title}" />
                    <Border Style="{StaticResource TitleUnderlineStyle}" Margin="0,8,0,12" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{Binding Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                    <views:CaptionedButton Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Label="{x:Static res:Strings.DashStartAll}" Command="{Binding StartAllCommand}" Caption="{x:Static res:Strings.CapDashStartAll}" />
                    <views:CaptionedButton Margin="8,0,0,0" Icon="{ui:SymbolIcon Stop24}" Label="{x:Static res:Strings.DashStopAll}" Command="{Binding StopAllCommand}" Caption="{x:Static res:Strings.CapDashStopAll}" />
                </StackPanel>
            </Grid>

            <ui:InfoBar Grid.Row="1" Margin="0,20,0,0"
                        IsOpen="{Binding IsNoticeOpen, Mode=TwoWay}"
                        Severity="{Binding NoticeSeverity}"
                        Message="{Binding NoticeMessage}"
                        IsClosable="True" />

            <ItemsControl Grid.Row="2" Margin="0,24,-12,0" ItemsSource="{Binding Cards}"
                          ItemTemplate="{StaticResource ServiceCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,4,0,0" Padding="20">
                <StackPanel>
                    <!-- PHP actif -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.DashPhpActive}" />
                        <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="140"
                                  ItemsSource="{Binding PhpVersions}"
                                  SelectedItem="{Binding SelectedPhp, Mode=TwoWay}"
                                  IsEnabled="{Binding HasPhp}" />
                        <ui:ProgressRing Grid.Column="2" Margin="10,0,0,0" Width="16" Height="16" IsIndeterminate="True"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsPhpBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.DashPhpHint}" />
                    </Grid>

                    <Border Style="{StaticResource AccentLineStyle}" Opacity="0.25" Margin="0,16,0,16" />

                    <!-- Raccourcis -->
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.DashShortcuts}" />
                    <WrapPanel Margin="0,8,0,0">
                        <views:CaptionedButton Margin="0,0,8,8" Icon="{ui:SymbolIcon Window24}" Label="{x:Static res:Strings.DashOpenTerminal}" Command="{Binding OpenTerminalCommand}" Caption="{x:Static res:Strings.CapDashOpenTerminal}" />
                        <views:CaptionedButton Margin="0,0,8,8" Icon="{ui:SymbolIcon Folder24}" Label="{x:Static res:Strings.DashOpenWww}" Command="{Binding OpenWwwCommand}" Caption="{x:Static res:Strings.CapDashOpenWww}" />
                        <views:CaptionedButton Margin="0,0,8,8" Icon="{ui:SymbolIcon Mail24}" Label="{x:Static res:Strings.DashOpenMailpit}" Command="{Binding OpenMailpitCommand}" Caption="{x:Static res:Strings.CapDashOpenMailpit}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                               Text="{Binding WwwPath, StringFormat={x:Static res:Strings.DashWwwFormat}}" />

                    <Border Style="{StaticResource AccentLineStyle}" Opacity="0.25" Margin="0,16,0,16" />

                    <!-- Sites récents -->
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Static res:Strings.DashRecentSites}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.CapRecentSitesHint}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RecentSites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:HyperlinkButton Margin="0,0,12,0" Padding="0" Content="{Binding}" ToolTip="{x:Static res:Strings.CapRecentSitesHint}"
                                                    Icon="{ui:SymbolIcon Open16}"
                                                    Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource NoSitesTextStyle}" Text="{x:Static res:Strings.DashNoSites}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
