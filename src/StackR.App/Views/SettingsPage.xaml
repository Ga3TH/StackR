<Page x:Class="StackR.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:StackR.App.Views"
      xmlns:res="clr-namespace:StackR.App.Resources"
      xmlns:local="clr-namespace:StackR.App.Views"
      Title="{Binding Title}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="InvertBool" />

        <Style x:Key="SettingsSectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextStyle}">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="PathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="PortBoxStyle" TargetType="ui:NumberBox">
            <Setter Property="Minimum" Value="1" />
            <Setter Property="Maximum" Value="65535" />
            <Setter Property="MaxDecimalPlaces" Value="0" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="Width" Value="140" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Title}" />
            <Border Style="{StaticResource TitleUnderlineStyle}" Margin="0,8,0,12" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{Binding Subtitle}" />

            <ui:InfoBar Margin="0,16,0,0" IsClosable="False" Severity="Warning"
                        IsOpen="{Binding NeedsRestart, Mode=OneWay}"
                        Title="{x:Static res:Strings.SetRestartTitle}"
                        Message="{x:Static res:Strings.SetRestartMessage}">
                <ui:InfoBar.Content>
                    <views:CaptionedButton Command="{Binding RestartNowCommand}" Appearance="Primary" Label="{x:Static res:Strings.SetRestartNow}" Caption="{x:Static res:Strings.CapSetRestartNow}" />
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <ui:InfoBar Margin="0,8,0,0" IsClosable="True"
                        IsOpen="{Binding IsMessageOpen, Mode=TwoWay}"
                        Severity="{Binding MessageSeverity}"
                        Message="{Binding Message}" />

            <!-- Mode sombre -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetDarkMode}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetDarkModeDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding FollowSystemTheme}"
                                  Content="{x:Static res:Strings.SetFollowWindows}"
                                  ToolTip="{x:Static res:Strings.CapFollowWindows}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" MaxWidth="170" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.CapFollowWindows}" />
                    </StackPanel>
                    <ui:ToggleSwitch IsChecked="{Binding IsDarkMode}" ToolTip="{x:Static res:Strings.SetDarkModeDesc}" IsEnabled="{Binding FollowSystemTheme, Converter={StaticResource InvertBool}}"
                                     AutomationProperties.Name="{x:Static res:Strings.SetDarkMode}" />
                </StackPanel>
            </ContentControl>
  </Grid>
</Border>

            <!-- Général -->
            <TextBlock Style="{StaticResource SettingsSectionTextStyle}" Text="{x:Static res:Strings.SetSectionGeneral}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetStartWithWindows}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetStartWithWindowsDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" ToolTip="{x:Static res:Strings.SetStartWithWindowsDesc}"
                                 AutomationProperties.Name="{x:Static res:Strings.SetStartWithWindows}" />
            </ContentControl>
  </Grid>
</Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="Play24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetAutoStart}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetAutoStartDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <ui:ToggleSwitch IsChecked="{Binding AutoStartServices}" ToolTip="{x:Static res:Strings.SetAutoStartDesc}"
                                 AutomationProperties.Name="{x:Static res:Strings.SetAutoStart}" />
            </ContentControl>
  </Grid>
</Border>

            <!-- Dossiers -->
            <TextBlock Style="{StaticResource SettingsSectionTextStyle}" Text="{x:Static res:Strings.SetSectionFolders}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="Folder24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetRoot}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetRootDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PathTextStyle}" Text="{Binding RootPath}" ToolTip="{Binding RootPath}" />
                    <views:CaptionedButton Command="{Binding ChooseRootCommand}" Label="{x:Static res:Strings.SetChange}" Caption="{x:Static res:Strings.CapSetChange}" />
                </StackPanel>
            </ContentControl>
  </Grid>
</Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="Globe24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetWww}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetWwwDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PathTextStyle}" Text="{Binding WwwPath}" ToolTip="{Binding WwwPath}" />
                    <views:CaptionedButton Command="{Binding ResetWwwCommand}" Margin="0,0,8,0" Label="{x:Static res:Strings.SetResetDefault}" Caption="{x:Static res:Strings.CapSetResetDefault}" />
                    <views:CaptionedButton Command="{Binding ChooseWwwCommand}" Label="{x:Static res:Strings.SetBrowse}" Caption="{x:Static res:Strings.CapSetBrowse}" />
                </StackPanel>
            </ContentControl>
  </Grid>
</Border>

            <!-- HTTPS -->
            <TextBlock Style="{StaticResource SettingsSectionTextStyle}" Text="{x:Static res:Strings.SetSectionHttps}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetHttps}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetHttpsDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <ui:ToggleSwitch IsChecked="{Binding HttpsEnabled}" ToolTip="{x:Static res:Strings.SetHttpsDesc}"
                                 AutomationProperties.Name="{x:Static res:Strings.SetHttps}" />
            </ContentControl>
  </Grid>
</Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetCaStatus}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetCaTrustDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"
                               FontWeight="SemiBold" Text="{Binding CaStatusText}" />
                    <views:CaptionedButton Command="{Binding TrustCaCommand}" IsEnabled="{Binding CanTrustCa}" Appearance="Primary" Label="{x:Static res:Strings.SetCaTrust}" Caption="{x:Static res:Strings.CapSetCaTrust}" />
                </StackPanel>
            </ContentControl>
  </Grid>
</Border>

            <!-- Ports -->
            <TextBlock Style="{StaticResource SettingsSectionTextStyle}" Text="{x:Static res:Strings.SetSectionPorts}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="{x:Static res:Strings.SetPortsDesc}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" Text="{x:Static res:Strings.SetPortHttp}" />
                            <ui:NumberBox Style="{StaticResource PortBoxStyle}" Value="{Binding HttpPort, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static res:Strings.SetPortHttp}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" Text="{x:Static res:Strings.SetPortHttps}" />
                            <ui:NumberBox Style="{StaticResource PortBoxStyle}" Value="{Binding HttpsPort, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static res:Strings.SetPortHttps}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" Text="{x:Static res:Strings.SetPortMySql}" />
                            <ui:NumberBox Style="{StaticResource PortBoxStyle}" Value="{Binding MySqlPort, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static res:Strings.SetPortMySql}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" Text="{x:Static res:Strings.SetPortMailpitUi}" />
                            <ui:NumberBox Style="{StaticResource PortBoxStyle}" Value="{Binding MailpitUiPort, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static res:Strings.SetPortMailpitUi}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" Text="{x:Static res:Strings.SetPortMailpitSmtp}" />
                            <ui:NumberBox Style="{StaticResource PortBoxStyle}" Value="{Binding MailpitSmtpPort, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static res:Strings.SetPortMailpitSmtp}" />
                        </StackPanel>
                    </Grid>
                    <views:CaptionedButton Margin="0,16,0,0" HorizontalAlignment="Left" Appearance="Primary" Command="{Binding SavePortsCommand}" Label="{x:Static res:Strings.SetPortsSave}" Caption="{x:Static res:Strings.CapSetPortsSave}" />
                </StackPanel>
            </Border>

            <!-- Apparence -->
            <TextBlock Style="{StaticResource SettingsSectionTextStyle}" Text="{x:Static res:Strings.SetSectionAppearance}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{x:Static res:Strings.SetLanguage}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="{x:Static res:Strings.SetLanguageDesc}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <ComboBox MinWidth="160" ToolTip="{x:Static res:Strings.SetLanguageDesc}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="Name" AutomationProperties.Name="{x:Static res:Strings.SetLanguage}" />
            </ContentControl>
  </Grid>
</Border>

            <!-- À propos -->
            <TextBlock Style="{StaticResource SettingsSectionTextStyle}" Text="{x:Static res:Strings.SetSectionAbout}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="StackR" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}">
                            <Run Text="{x:Static res:Strings.SetAboutVersion}" /> <Run Text="{Binding VersionText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <views:CaptionedButton Command="{Binding OpenGitHubCommand}" Icon="{ui:SymbolIcon Open24}" Label="{x:Static res:Strings.SetAboutGitHub}" Caption="{x:Static res:Strings.CapSetAboutGitHub}" />
            </ContentControl>
  </Grid>
</Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
    <ContentControl Grid.Column="1" VerticalAlignment="Center" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Text="{Binding RootPath}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding LogsPath}" />
                    </StackPanel>
                </ContentControl>
    <ContentControl Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <views:CaptionedButton Command="{Binding OpenRootCommand}" Margin="0,0,8,0" Label="{x:Static res:Strings.SetAboutRootFolder}" Caption="{x:Static res:Strings.CapSetAboutRootFolder}" />
                    <views:CaptionedButton Command="{Binding OpenLogsCommand}" Label="{x:Static res:Strings.SetAboutLogsFolder}" Caption="{x:Static res:Strings.CapSetAboutLogsFolder}" />
                </StackPanel>
            </ContentControl>
  </Grid>
</Border>
        </StackPanel>
    </ScrollViewer>
</Page>
