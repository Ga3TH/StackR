<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StackR.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- CLI (assembly « stackr ») : accès à l'élévation et à l'écriture du fichier hosts du moteur. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>stackr</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <EmbeddedResource Include="..\..\manifest\components.json" LogicalName="StackR.Core.components.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Config/Templates/*.tpl" LogicalName="StackR.Core.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
